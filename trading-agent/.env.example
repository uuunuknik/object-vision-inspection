# Copy to .env and fill in. Never commit .env.

# Option A, VPS + own domain (docker-compose.yml):
DOMAIN=mytrader.duckdns.org
# Option B, no VPS (docker-compose.home.yml): from dashboard.ngrok.com
NGROK_AUTHTOKEN=
NGROK_DOMAIN=your-name.ngrok-free.app

TV_SECRET=put-a-long-random-string-here
VIEW_KEY=another-random-string-for-viewing-pnl

LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
WINRATE_ALERT=50
WINRATE_MIN_TRADES=5
DAILY_SUMMARY_AT=17:30

MAX_POSITIONS=5
MAX_ENTRY_RSI=75
TRADE_SIZE_THB=10000
COMMISSION=0.0015
